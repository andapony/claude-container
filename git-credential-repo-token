#!/bin/sh
# git-credential-repo-token -- give one GitHub repo a token of its own.
#
#   git-credential-repo-token --add URL VARIABLE    # at build time
#   git-credential-repo-token VARIABLE get          # as git calls it
#
# The container's GitHub credential is GH_TOKEN, answered by gh for all of
# github.com. A repo that token can't reach -- a personal repo, in a
# container whose GH_TOKEN belongs to a work account -- can be given a
# second token, in an environment variable of its own, VARIABLE, passed with
# --env-file like GH_TOKEN. Only git uses it, and only for URL: gh still
# reads GH_TOKEN, and so does git for every other repo.
#
# --add writes URL's entry into the global git config, after the github.com
# helper the image has already set:
#
#   [credential "URL"]          (and the same again for URL.git)
#       helper =                clears the github.com helper inherited here
#       helper = repo-token VARIABLE
#       helper = !gh auth git-credential
#       useHttpPath = true
#
# git applies every credential section matching a URL, in file order, and
# an empty helper clears the list so far, so URL's helpers are this one and
# then gh. URL.git gets an entry too because git matches the path by whole
# segments: an entry for .../emacs.d doesn't cover .../emacs.d.git, which is
# what a rewritten SSH remote becomes. useHttpPath sends the helpers the
# path, so whatever they see is the repo, not just github.com.
#
# As a helper it answers `get' with VARIABLE's token, and says nothing when
# VARIABLE is unset or empty, so git asks gh next, exactly as it did with no
# entry. `store' and `erase' do nothing: the token lives in the environment.
# Another repo is one more --add, with a variable of its own.

set -eu

if [ "${1-}" = --add ]; then
  [ "$#" -eq 3 ] || { echo "usage: $0 --add URL VARIABLE" >&2; exit 2; }
  url=${2%/} var=$3
  case "$var" in
    ''|[0-9]*|*[!A-Za-z0-9_]*)
      echo "$0: not a variable name: $var" >&2; exit 2 ;;
  esac
  for u in "$url" "$url.git"; do
    git config --global --add "credential.$u.helper" ''
    git config --global --add "credential.$u.helper" "repo-token $var"
    git config --global --add "credential.$u.helper" '!gh auth git-credential'
    git config --global "credential.$u.useHttpPath" true
  done
  exit 0
fi

[ "$#" -eq 2 ] || { echo "usage: $0 VARIABLE get|store|erase" >&2; exit 2; }
var=$1 op=$2
cat > /dev/null   # git's description of the request; the config chose it
[ "$op" = get ] || exit 0
token=$(printenv "$var" || true)
[ -n "$token" ] || exit 0
printf 'username=x-access-token\npassword=%s\n' "$token"
