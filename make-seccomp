#!/bin/sh
# make-seccomp -- regenerate seccomp.json from Docker's default profile.
#
#   ./make-seccomp [moby/profiles commit]   # writes seccomp.json here
#
# seccomp.json is what the macOS run line passes with --security-opt, so that
# rootless podman can run inside the claude-dev container. It is Docker's
# default profile with one change: the syscalls a user namespace needs, which
# the default allows only to a container holding CAP_SYS_ADMIN (or, for
# keyctl, never), are allowed outright. See the Dockerfile header and
# docs/adr/0001 for why that is acceptable.
#
# The upstream commit is pinned, so a rerun reproduces the committed file. To
# take a newer default, pass its commit and review the diff.

set -eu
commit=${1:-6fe7deb1b9fb7c0397a4593480d7d22b9ee8caef}
cd "$(dirname "$0")"

# clone: drop the default's entries that allow it only without namespace
# flags (every entry naming clone alone), and allow it unconditionally
# instead. clone3 stays as the default has it, failing with ENOSYS, which
# makes glibc and crun fall back to clone.
#
# sethostname and the fs*/open_tree/move_mount/mount_setattr family go beyond
# the list in andapony/claude-container#1: crun sets the nested container's
# hostname in its own UTS namespace, and the default answers the new mount
# API with EPERM, which crun takes as failure rather than falling back to
# mount(2). Each is gated by the kernel on CAP_SYS_ADMIN in the namespace it
# acts on, exactly as mount(2) is. keyctl is different: the default blocks it
# outright, CAP_SYS_ADMIN or not, and crun needs it to give each nested
# container a session keyring of its own.
#
# Downloaded to a file first: sh has no pipefail, so a failed curl piped
# into jq would write an empty profile and still exit 0.
tmp=$(mktemp)
trap 'rm -f "$tmp" seccomp.json.tmp' EXIT
curl -fsSL -o "$tmp" "https://raw.githubusercontent.com/moby/profiles/$commit/seccomp/default.json"
jq --indent 1 '
    .syscalls |= map(select(.names != ["clone"]))
    | .syscalls += [{
        names: ["clone", "unshare", "setns", "mount", "umount2", "pivot_root",
                "keyctl", "sethostname", "open_tree", "move_mount",
                "mount_setattr", "fsopen", "fsconfig", "fsmount"],
        action: "SCMP_ACT_ALLOW",
        comment: "user namespaces for nested rootless podman; generated by make-seccomp"
      }]' "$tmp" > seccomp.json.tmp
mv seccomp.json.tmp seccomp.json
